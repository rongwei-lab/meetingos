# MeetingOS MVP environment example
# 复制为 .env 后再部署。生产环境必须替换所有 CHANGE_ME、默认密码和弱密钥。

# -----------------------------------------------------------------------------
# Compose / images
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=meetingos
TZ=Asia/Shanghai

# 后端和前端镜像由对应子项目构建后推送，Compose 只负责部署。
MEETINGOS_BACKEND_IMAGE=meetingos-backend:1.0.0
MEETINGOS_FRONTEND_IMAGE=meetingos-admin:1.0.0

# TDuck 作为独立系统部署。MVP 模板默认用 profile=tduck 启动，生产建议固定镜像版本。
TDUCK_BACKEND_IMAGE=tduckcloud/tduck-platform:1.0.0
TDUCK_FRONTEND_IMAGE=meetingos-tduck-front:1.0.0

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=https://meeting.example.com
MEETINGOS_PUBLIC_BASE_URL=https://meeting.example.com
ADMIN_BASE_URL=https://meeting.example.com
API_BASE_URL=https://meeting.example.com/api
# MeetingOS 后台上传资源持久化目录，Compose 默认挂载到该路径。
MEETINGOS_UPLOAD_DIR=/app/uploads

# TDuck 由同域 Nginx 反代暴露，避免跨域和 Cookie 域问题。
TDUCK_PUBLIC_URL=https://meeting.example.com/tduck
TDUCK_API_PUBLIC_URL=https://meeting.example.com/tduck-api
# 后端容器访问 TDuck 管理 API 的内部地址；单机非容器部署可与 TDUCK_API_PUBLIC_URL 相同。
TDUCK_ADMIN_API_URL=http://tduck-backend:8999

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=meetingos
MYSQL_USER=meetingos
MYSQL_PASSWORD=CHANGE_ME_MEETINGOS_DB_PASSWORD
MYSQL_BIND_HOST=127.0.0.1
MYSQL_PORT=3306

# TDuck 建议使用独立 schema。若改为独立实例，也应保持与 MeetingOS 数据隔离。
TDUCK_MYSQL_DATABASE=tduck
TDUCK_MYSQL_USER=tduck
TDUCK_MYSQL_PASSWORD=CHANGE_ME_TDUCK_DB_PASSWORD

# 后端 JDBC 配置。容器内部通过服务名访问 mysql。
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/meetingos?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=meetingos
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_MEETINGOS_DB_PASSWORD

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# 当前 MeetingOS 和 TDuck 都使用进程内缓存。需要多副本缓存时才使用
# `./scripts/deploy.sh ../.env --profile redis up -d` 显式启动 Redis。
REDIS_HOST=redis
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
SPRING_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# -----------------------------------------------------------------------------
# MinIO / S3-compatible storage
# -----------------------------------------------------------------------------
# 当前上传使用本地卷。需要 S3/异步导出时才使用
# `./scripts/deploy.sh ../.env --profile minio up -d` 显式启动 MinIO。
# root 凭据只供 minio-init 管理 bucket/IAM，业务应用必须使用下面的独立受限账号。
MINIO_ROOT_USER=meetingos_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BIND_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=meetingos
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=https://meeting.example.com/minio
MINIO_ACCESS_KEY=meetingos_app
MINIO_SECRET_KEY=CHANGE_ME_MINIO_APP_SECRET_KEY

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# JWT_SECRET 至少 32 字节，生产建议使用 openssl rand -base64 48 生成。
JWT_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES_123456
# 后端当前按分钟计算访问令牌有效期。
MEETINGOS_SECURITY_ACCESS_TOKEN_MINUTES=720
MEETINGOS_SECURITY_SECURE_COOKIES=true

# 邀请函匿名访客标识和报名点击 token 使用独立 HMAC 密钥，至少 32 字节。
# 生产建议使用 `openssl rand -base64 48` 生成，不能与 JWT/Webhook 密钥复用。
MEETINGOS_INVITATION_TRACKING_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_INVITATION_SECRET_AT_LEAST_32_BYTES
# 邀请函访问/点击明细在会议结束后保留的天数；报名归因记录不随该任务清理。
MEETINGOS_INVITATION_EVENT_RETENTION_DAYS=180
# 系统操作日志按创建时间保留的天数；超过期限的记录由后端每日清理。
MEETINGOS_OPERATION_LOG_RETENTION_DAYS=90
# 可选：操作日志清理时间，默认每天 03:45（部署时区）。
MEETINGOS_OPERATION_LOG_CLEANUP_CRON=0 45 3 * * *
# 高德地图三项必须全空或全有；启用时前后端 Key 必须填写相同值。
# 后端 Key 用于发布校验，前端 Key 和安全码会在镜像构建阶段固化。
MEETINGOS_INVITATION_AMAP_KEY=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# TDuck Webhook 推送到 MeetingOS 时必须携带该 Token。
# 推荐请求头：X-MeetingOS-Webhook-Token: ${TDUCK_WEBHOOK_TOKEN}
TDUCK_WEBHOOK_TOKEN=CHANGE_ME_RANDOM_WEBHOOK_TOKEN
# TDuck 后端实际访问 MeetingOS 的内部回调地址；Docker Compose 同机部署可用 http://nginx。
MEETINGOS_WEBHOOK_INTERNAL_URL=https://meeting.example.com/api/integrations/tduck/webhook

# 对外查询页可按需要开启验证码/限流，避免手机号枚举。
PUBLIC_QUERY_RATE_LIMIT_PER_MINUTE=30
PUBLIC_QUERY_CAPTCHA_ENABLED=false
PUBLIC_QUERY_CAPTCHA_TTL_SECONDS=300
# Compose 中后端不映射宿主机端口，且边界 Nginx 会覆盖 X-Forwarded-For，因此可安全信任。
# 若改为公网直连后端或绕过本仓库 Nginx，必须设为 false，防止伪造来源地址绕过限流。
PUBLIC_QUERY_TRUST_FORWARD_HEADERS=true

# -----------------------------------------------------------------------------
# Initial admin
# -----------------------------------------------------------------------------
# 仅首次初始化使用。首次登录后必须修改密码，并禁用默认初始化入口。
MEETINGOS_INIT_ADMIN_USERNAME=admin
MEETINGOS_INIT_ADMIN_PASSWORD=CHANGE_ME_INIT_ADMIN_PASSWORD
MEETINGOS_INIT_ADMIN_EMAIL=admin@example.com

# TDuck 社区版默认管理员账号通常为 admin@tduckcloud.com / 123456。
# 上线前必须登录 TDuck 后台修改默认密码，禁止使用 123456。
TDUCK_DEFAULT_ADMIN_EMAIL=admin@tduckcloud.com
TDUCK_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_NEVER_USE_123456
# MeetingOS 后端用于只读拉取 TDuck 表单列表和保存前校验表单；不要暴露到前端。
TDUCK_ADMIN_EMAIL=admin@tduckcloud.com
TDUCK_ADMIN_PASSWORD=CHANGE_ME_TDUCK_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# Integration
# -----------------------------------------------------------------------------
# 会议系统公开报名中转地址格式：${PUBLIC_BASE_URL}/r/{meetingCode}
# 后端应根据 meetingCode 查询已绑定的 tduck_form_key，再跳转到：
# ${TDUCK_PUBLIC_URL}/s/{formKey}
REGISTRATION_REDIRECT_PREFIX=/r

# -----------------------------------------------------------------------------
# Runtime tuning
# -----------------------------------------------------------------------------
BACKEND_SERVER_PORT=8080
JAVA_OPTS=-Xms512m -Xmx1024m -Duser.timezone=Asia/Shanghai
NGINX_HTTP_PORT=80
# 默认 Compose 只暴露 HTTP。生产 HTTPS 请使用带真实证书的 Nginx/负载均衡或单独 override。
