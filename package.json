{
  "name": "meetingos-monorepo",
  "private": true,
  "version": "0.14.0",
  "description": "MeetingOS 会议管理系统完整 MVP monorepo",
  "scripts": {
    "admin:install": "npm --prefix meetingos-admin install",
    "admin:dev": "npm --prefix meetingos-admin run dev",
